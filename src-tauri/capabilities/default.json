{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "pty:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    {
      "identifier": "fs:scope",
      "comment": "Projects can live anywhere on disk, so the picker must not be limited to $HOME. The webview only ever loads local app content, so a broad scope adds no remote-content exposure.",
      "allow": [{ "path": "/**" }, { "path": "$HOME/**" }, { "path": "$APPCONFIG/**" }]
    }
  ]
}
